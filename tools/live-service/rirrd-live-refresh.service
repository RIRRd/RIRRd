[Unit]
Description=Build and verify RIRRd daily routing snapshots before generation switch
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/local/lib/rirrd-live/refresh.py
TimeoutStartSec=2h
CPUQuota=200%
MemoryMax=2G
MemorySwapMax=0
Nice=10
IOSchedulingClass=idle
PrivateTmp=true
ProtectHome=true
NoNewPrivileges=true
UMask=0077

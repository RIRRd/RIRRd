{
	servers {
		protocols h1 h2
	}
}
(common_headers) {
	encode gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src 'self'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"
		Cache-Control no-cache
	}
}
(query_gateway) {
	@queries path /graphql/ /v1/whois/ /v1/irr/objects /dashboard/meta.json /dashboard/live.json /dashboard/history.json
	handle @queries {
		reverse_proxy 127.0.0.1:9281 {
			header_up Host 127.0.0.1
			header_up X-RIRRd-Client {remote_host}
		}
	}
}
rirrd.co.uk {
	import common_headers
	import query_gateway
	handle /dashboard* {
		redir https://irrd.tools{uri} 308
	}
	redir /self-host/* /docs/getting-started/ 308
	redir /guides/api/* /docs/api/ 308
	redir /guides/routers/* /docs/routers/ 308
	redir /project/* /#benchmarks 308
	handle {
		root * /var/www/rirrd-project
		file_server
	}
}
irrd.tools {
	import common_headers
	import query_gateway
	handle /community/node-submissions {
		reverse_proxy 127.0.0.1:9282 {
			header_up Host 127.0.0.1
			header_up X-RIRRd-Client {remote_host}
		}
	}
	redir /self-host/* https://rirrd.co.uk/docs/getting-started/ 308
	redir /project/* https://rirrd.co.uk/#benchmarks 308
	handle {
		root * /var/www/irrd-tools
		file_server
	}
}

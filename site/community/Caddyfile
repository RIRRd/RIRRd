{
	servers {
		protocols h1 h2
	}
}
rirrd.co.uk {
	root * /var/www/rirrd-community
	encode gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; connect-src 'self'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"
	}
	@assets path / /community.js /community.css /nodes.json /dashboard/ /dashboard/index.html /dashboard/app.js /dashboard/style.css
	header @assets Cache-Control "no-cache"
	@queries path /graphql/ /v1/whois/ /v1/rpki/status /v1/rpki/validate /v1/irr/objects /dashboard/meta.json /dashboard/live.json
	reverse_proxy @queries 127.0.0.1:9281 {
		header_up Host 127.0.0.1
		header_up X-RIRRd-Client {remote_host}
	}
	@submission path /community/node-submissions
	reverse_proxy @submission 127.0.0.1:9282 {
		header_up Host 127.0.0.1
		header_up X-RIRRd-Client {remote_host}
	}
	file_server
}
